{
  "name": "@nuqayah/prosekit-hyperlink",
  "version": "0.0.0",
  "description": "A polished hyperlink extension for ProseKit with optional Svelte UI",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./basic": {
      "types": "./dist/basic.d.ts",
      "import": "./dist/basic.js",
      "default": "./dist/basic.js"
    },
    "./protocols": {
      "types": "./dist/protocols.d.ts",
      "import": "./dist/protocols.js",
      "default": "./dist/protocols.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm run check && pnpm run test && pnpm run build && publint && pnpm run types:check && pnpm run demo:check && vite build --config demo/vite.config.ts",
    "pack:dry": "pnpm pack --dry-run",
    "types:check": "attw --pack . --profile esm-only --entrypoints . ./basic ./protocols ./markdown ./svelte",
    "demo:check": "svelte-check --tsconfig ./demo/tsconfig.json",
    "demo:build": "pnpm run build && pnpm run demo:check && vite build --config demo/vite.config.ts",
    "demo:dev": "pnpm run build && vite --config demo/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "linkify-it": "5.0.2"
  },
  "peerDependencies": {
    "@floating-ui/dom": ">=1.7 <2",
    "prosekit": ">=0.21.4 <0.22",
    "prosemirror-markdown": ">=1.13 <2",
    "svelte": ">=5"
  },
  "peerDependenciesMeta": {
    "@floating-ui/dom": {
      "optional": true
    },
    "prosemirror-markdown": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "latest",
    "@floating-ui/dom": "1.8.0",
    "@playwright/test": "1.61.1",
    "@sveltejs/package": "2.5.7",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/linkify-it": "latest",
    "@types/node": "24.12.2",
    "happy-dom": "20.9.0",
    "prosekit": "0.21.4",
    "prosemirror-collab": "1.3.1",
    "prosemirror-markdown": "1.13.2",
    "publint": "latest",
    "svelte": "5.56.6",
    "svelte-check": "4.5.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.1.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
